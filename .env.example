# Projeto Supabase (Settings > API no dashboard).
# Este mesmo projeto sera reaproveitado depois para o banco de "criadoras"
# (Leads + Propostas de UGC), quando esses modulos forem construidos.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-anon-key-publica"

# URL da Central de Producao ja existente (sistema separado, com seu proprio
# login). Enquanto nao estiver definida, o card no menu aparece como "em breve".
NEXT_PUBLIC_CENTRAL_PRODUCAO_URL="https://unica-producao.vercel.app/"

# Banco do modulo Financeiro: o Postgres desse mesmo projeto Supabase
# (botao Connect > Direct > Session pooler), num schema PRIVADO -- nunca o
# public, que e exposto pela chave publica. O app se recusa a rodar sem
# ?schema=. Local: financeiro_teste. Vercel (producao): financeiro.
DATABASE_URL="postgresql://postgres.xxxxxxxx:SENHA@aws-0-us-east-1.pooler.supabase.com:5432/postgres?schema=financeiro_teste"

# Shopify (mesmo app/chave da Central de Producao, escopo read_products).
SHOPIFY_STORE_DOMAIN="sua-loja.myshopify.com"
SHOPIFY_ADMIN_ACCESS_TOKEN="shpat_..."

# Parcerias: senha que o Apps Script do Google Forms de permuta manda junto
# com cada resposta (/api/parcerias/formulario?token=...). Um texto longo e
# aleatorio; o codigo pronto pra colar aparece em /parcerias/formulario.
PARCERIAS_FORM_TOKEN="troque-por-um-texto-longo-aleatorio"

# Opcional: liga o botao "Analisar com o Claude" nas propostas recebidas.
# Sem ela, a avaliacao e so pelo checklist manual.
ANTHROPIC_API_KEY=""
