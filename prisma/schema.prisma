generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Modulo Financeiro do Mundo da Unica. As tabelas ficam num schema privado
// do Supabase (ver src/lib/db-url.ts), nunca no public.
//
// "Composicao" e o que forma o custo: materiais (ficha tecnica), produtos
// (componentes de kit) ou custo de compra (revenda). Ela pertence ao produto
// inteiro, ou a cada variante quando Produto.custoPorVariante = true.

// Produto do Shopify. Titulo, status e link sempre vem da sincronizacao;
// tipo, custo e composicao sao preenchidos aqui pela Lari e nunca sao
// tocados pelo sync.
model Produto {
  id               String  @id @default(cuid())
  shopifyProductId String  @unique // gid://shopify/Product/123...
  title            String
  status           String? // ACTIVE, DRAFT ou ARCHIVED no Shopify
  url              String? // onlineStoreUrl, nulo se nao esta publicado no site

  tipo TipoProduto? // null ate ser classificado

  // false: uma composicao so, vale pra todas as variantes (ex: variantes de
  // cor). true: cada variante tem a sua (ex: A5 x Personal, papel diferente).
  custoPorVariante Boolean @default(false)

  // So pra tipo=revenda com custo unico: custo de compra do produto pronto.
  custoCompra Decimal? @db.Decimal(10, 2)

  // Minutos de trabalho manual pra produzir uma unidade (imprimir, tirar da
  // impressora, furar, encadernar, embalar o item). Vira custo pelo valor da
  // hora de producao. Na variante quando custoPorVariante.
  minutosProducao Decimal? @db.Decimal(8, 2)

  variantes    Variante[]
  fichaTecnica FichaTecnicaItem[] // todas as linhas do produto, inclusive as por variante
  componentes  KitItem[]          @relation("KitDoProduto")
  impressoes   ImpressaoItem[]

  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([title])
}

enum TipoProduto {
  revenda
  producao_propria
  kit
  ignorar // "Nao contar": brindes e o que nao precisa de custo; sai da lista de pendentes
}

// Variante do Shopify (A5 Argolado, Personal Argolado / 120g...). Titulo,
// SKU, preco e posicao vem do sync. Variante que sumiu do Shopify fica com
// ativa=false em vez de ser apagada, pra nao quebrar kits que usam ela.
model Variante {
  id               String  @id @default(cuid())
  shopifyVariantId String  @unique // gid://shopify/ProductVariant/123...
  produtoId        String
  produto          Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  title   String // "Default Title" quando o produto nao tem variantes de verdade
  sku     String?
  preco   Decimal? @db.Decimal(10, 2) // preco de venda no Shopify
  posicao Int      @default(0)
  ativa   Boolean  @default(true)

  // So pra tipo=revenda com custo por variante.
  custoCompra Decimal? @db.Decimal(10, 2)

  minutosProducao Decimal? @db.Decimal(8, 2) // so com custoPorVariante (ver Produto)

  fichaTecnica       FichaTecnicaItem[]
  componentes        KitItem[]           @relation("KitDaVariante")
  usadaEmKits        KitItem[]           @relation("ComponenteDoKit")
  impressoes         ImpressaoItem[]
  enviadaEmParcerias ItemEnvioParceria[]

  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([produtoId])
}

// Materia-prima ou embalagem. custoAtual nunca e editado direto: e sempre o
// custo unitario da compra mais recente (por data da compra).
model Material {
  id      String @id @default(cuid())
  nome    String @unique
  unidade String // "folha", "un", "m", "kg"... e o que aparece na ficha tecnica

  custoAtual Decimal @default(0) @db.Decimal(10, 4)

  linkCompra String? // anuncio onde a Lari compra (ex: Mercado Livre), pra recomprar rapido
  // folha que e impressa (frente e verso): o custo da impressao entra junto,
  // na mesma quantidade -- nao precisa lancar a impressao separada
  impresso   Boolean @default(false)

  // Contagem de estoque (na unidade do material) e quando foi feita. O
  // estoque atual = contagem + compras depois dela - consumo pelas vendas.
  estoqueContado   Decimal?  @db.Decimal(12, 2)
  estoqueContadoEm DateTime?

  compras      Compra[]
  fichaTecnica FichaTecnicaItem[]
  envios       EnvioMaterial[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Compra {
  id String @id @default(cuid())

  materialId String
  material   Material @relation(fields: [materialId], references: [id])

  data          DateTime // data da compra (pode ser retroativa)
  quantidade    Decimal     @db.Decimal(10, 2)
  valorTotal    Decimal     @db.Decimal(10, 2)
  custoUnitario Decimal     @db.Decimal(10, 4) // valorTotal / quantidade
  fornecedor    String? // nome digitado (fica igual ao do cadastro quando ligado)
  fornecedorId  String?
  fornecedorRef Fornecedor? @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([materialId, data])
  @@index([fornecedorId])
}

// Ficha do fornecedor: dados de contato, mensagens importantes e as compras
// feitas com ele (ultimas compras, precos ao longo do tempo, o que compramos).
model Fornecedor {
  id          String  @id @default(cuid())
  nome        String  @unique
  whatsapp    String? // so numeros, com DDD (o link wa.me poe o 55)
  link        String? // loja ou anuncio
  observacoes String?

  compras   Compra[]
  mensagens MensagemFornecedor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MensagemFornecedor {
  id           String     @id @default(cuid())
  fornecedorId String
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  data         DateTime   @default(now())
  texto        String

  createdAt DateTime @default(now())

  @@index([fornecedorId])
}

// Quanto de um material entra em uma unidade (producao propria, ou
// embalagem/extras de um kit). varianteId nulo = composicao do produto
// inteiro. Um material aparece no maximo uma vez por dono -- garantido no
// codigo, porque unique com coluna nula nao barra repeticao no Postgres.
model FichaTecnicaItem {
  id String @id @default(cuid())

  produtoId  String
  produto    Produto   @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  varianteId String?
  variante   Variante? @relation(fields: [varianteId], references: [id], onDelete: Cascade)

  materialId String
  material   Material @relation(fields: [materialId], references: [id])

  quantidade Decimal @db.Decimal(10, 4)

  @@index([produtoId])
  @@index([varianteId])
}

// Um produto (numa variante especifica) dentro de um kit. kitVarianteId nulo
// = composicao do kit inteiro. Kit nao entra dentro de outro kit.
model KitItem {
  id String @id @default(cuid())

  kitProdutoId  String
  kitProduto    Produto   @relation("KitDoProduto", fields: [kitProdutoId], references: [id], onDelete: Cascade)
  kitVarianteId String?
  kitVariante   Variante? @relation("KitDaVariante", fields: [kitVarianteId], references: [id], onDelete: Cascade)

  componenteVarianteId String
  componente           Variante @relation("ComponenteDoKit", fields: [componenteVarianteId], references: [id])

  quantidade Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([kitProdutoId])
  @@index([kitVarianteId])
  @@index([componenteVarianteId])
}

// Impressora usada na producao. Custo por pagina (um lado impresso) =
// (preco / vida util + tinta por ano + manutencao por ano) / paginas por ano.
// Sem paginasAno o custo fica em aberto e os produtos aparecem incompletos.
model Impressora {
  id            String  @id @default(cuid())
  nome          String  @unique // apelido, ex: "Guerreira Mae"
  modelo        String? // ex: "Canon GX6010"
  precoCompra   Decimal @db.Decimal(10, 2)
  vidaUtilAnos  Decimal @db.Decimal(4, 1)
  tintaAno      Decimal @db.Decimal(10, 2)
  manutencaoAno Decimal @default(0) @db.Decimal(10, 2)
  paginasAno    Int?

  itens  ImpressaoItem[]
  envios EnvioImpressao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Quantas folhas impressas vao numa unidade. Toda folha conta frente e verso,
// e o custo da folha e o da impressora mais cara (cobre mesmo quando imprime
// na outra): custo = folhas x 2 x custo por pagina dela. impressoraId ficou
// de quando se escolhia a impressora; itens novos nao tem.
// varianteId nulo = composicao do produto inteiro, igual a ficha tecnica.
model ImpressaoItem {
  id String @id @default(cuid())

  produtoId    String
  produto      Produto     @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  varianteId   String?
  variante     Variante?   @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  impressoraId String?
  impressora   Impressora? @relation(fields: [impressoraId], references: [id])

  folhas Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([produtoId])
  @@index([varianteId])
  @@index([impressoraId])
}

// Custo que existe todo mes, vendendo ou nao (pro-labore, contador, plano
// do Shopify, apps...). O total, dividido pelo faturamento medio, vira o %
// de custo fixo que entra no markup.
model CustoFixo {
  id          String  @id @default(cuid())
  nome        String
  categoria   String
  valorMensal Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Despesa que acompanha cada venda, em % do preco de venda (imposto do
// Simples, taxa de cartao/gateway, comissao).
model DespesaVariavel {
  id         String  @id @default(cuid())
  nome       String
  percentual Decimal @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Parametros gerais da precificacao (uma linha so, id "unica").
model ConfiguracaoPrecificacao {
  id                  String    @id @default("unica")
  faturamentoMensal   Decimal?  @db.Decimal(12, 2) // faturamento medio usado pra ratear os fixos
  lucroDesejado       Decimal   @default(20) @db.Decimal(5, 2) // % sobre o preco, depois de pagar tudo (inclusive pro-labore e mao de obra)
  // Quanto custa uma hora de producao: o que seria pago a alguem pra imprimir,
  // furar, encadernar e embalar (salario + encargos / horas produtivas).
  valorHora           Decimal?  @db.Decimal(10, 2)
  // Meta de margem de contribuicao por tipo (% do preco que sobra depois do
  // custo do produto, embalagem de envio, taxas e imposto). E o que paga os
  // custos fixos: produto de revenda com margem curta paga menos, a producao
  // propria compensa. O lucro desejado vale pro negocio como um todo.
  margemProducao      Decimal   @default(65) @db.Decimal(5, 2)
  margemRevenda       Decimal   @default(30) @db.Decimal(5, 2)
  margemKit           Decimal   @default(50) @db.Decimal(5, 2)
  vendasAtualizadasEm DateTime? // ultima vez que as vendas do Shopify foram puxadas
  // Saldo em conta informado pela Lari (ponto de partida do fluxo de caixa)
  saldoCaixa          Decimal?  @db.Decimal(12, 2)
  saldoCaixaEm        DateTime?

  updatedAt DateTime @updatedAt
}

// Vendas do Shopify somadas por variante e por mes (fuso de Sao Paulo), sem
// pedidos cancelados nem de teste. receita = preco depois de todos os
// descontos x quantidade que ficou no pedido (sem devolvidos). Item sem
// variante (item avulso de pedido manual, produto apagado) fica com
// shopifyVariantId nulo e chave "avulso:<titulo>". Sem relacao com Variante:
// a venda continua valendo mesmo se a variante sumir do Shopify.
model VendaMensal {
  id               String  @id @default(cuid())
  mes              String // "2026-09"
  chave            String // shopifyVariantId, ou "avulso:<titulo>"
  shopifyVariantId String?
  shopifyProductId String?
  titulo           String
  quantidade       Int
  receita          Decimal @db.Decimal(12, 2)

  @@unique([mes, chave])
  @@index([shopifyVariantId])
}

// Embalagem de envio: o que vai em cada PEDIDO (caixa, papel de seda, mimos
// de unboxing, etiqueta), independente de quantos produtos ele tem. Cada tipo
// (Caixa Planner, Caixa Bloco, Caixa A4) tem a sua composicao e o % dos
// pedidos que usam ele; a media ponderada vira o custo medio por pedido.
model TipoEnvio {
  id         String   @id @default(cuid())
  nome       String   @unique
  quando     String? // regra de uso, ex: "pedidos com case fichario"
  percentual Decimal  @default(0) @db.Decimal(5, 2) // % dos pedidos que vao nessa embalagem
  minutos    Decimal? @db.Decimal(8, 2) // tempo de montar e embalar um pedido (vira custo pelo valor da hora)
  ordem      Int      @default(0)

  materiais  EnvioMaterial[]
  impressoes EnvioImpressao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EnvioMaterial {
  id          String    @id @default(cuid())
  tipoEnvioId String
  tipoEnvio   TipoEnvio @relation(fields: [tipoEnvioId], references: [id], onDelete: Cascade)
  materialId  String
  material    Material  @relation(fields: [materialId], references: [id])
  quantidade  Decimal   @db.Decimal(10, 4)

  createdAt DateTime @default(now())

  @@unique([tipoEnvioId, materialId])
}

// Folhas impressas em cada pedido (ex: folhas de bloco pra experimentar, guia).
// Toda folha conta frente e verso, com o custo da impressora mais cara, igual
// na ficha do produto. Uma linha por embalagem (a rota garante); impressoraId
// ficou opcional e os itens novos nao tem.
model EnvioImpressao {
  id           String      @id @default(cuid())
  tipoEnvioId  String
  tipoEnvio    TipoEnvio   @relation(fields: [tipoEnvioId], references: [id], onDelete: Cascade)
  impressoraId String?
  impressora   Impressora? @relation(fields: [impressoraId], references: [id])
  folhas       Decimal     @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@unique([tipoEnvioId, impressoraId])
}

// Pedidos e faturamento de produtos por mes (mesmas regras de VendaMensal),
// pra saber o valor medio por pedido.
model ResumoMensal {
  mes     String  @id // "2026-09"
  pedidos Int
  receita Decimal @db.Decimal(12, 2)
  frete   Decimal @default(0) @db.Decimal(12, 2) // frete cobrado dos clientes (pro medidor do MEI)
}

// ---------------------------------------------------------------------------
// Modulo Parcerias (criadoras / influenciadoras). Um cadastro so de criadora
// pra prospeccao ativa (Leads) e propostas recebidas por DM (UGC), separados
// pela origem. Depois que fecha, a mesma ficha acompanha envio, posts
// combinados, pagamento e as vendas do cupom dela.

enum StatusCriadora {
  nova // acabou de ser capturada, ainda nao revisada
  pra_contatar
  contatada
  respondeu
  negociando
  fechada
  nao_seguiu // recusou ou nao respondeu
  descartada // a Lari decidiu nao seguir
}

enum OrigemCriadora {
  prospeccao // a Lari achou rolando o feed
  proposta // a criadora mandou proposta por DM
  indicacao
}

enum TipoAcordo {
  presente // seeding: sem obrigacao de postar
  permuta // produto em troca de conteudo combinado
  pago // cache
  afiliada // comissao por venda do cupom
}

enum Recomendacao {
  aprovar
  investigar
  recusar
}

model Campanha {
  id        String    @id @default(cuid())
  nome      String    @unique // "Onda 1"
  descricao String?
  inicio    DateTime?
  fim       DateTime?

  criadoras Criadora[]
  tarefas   TarefaCampanha[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TarefaCampanha {
  id          String   @id @default(cuid())
  campanhaId  String
  campanha    Campanha @relation(fields: [campanhaId], references: [id], onDelete: Cascade)
  fase        String // "Preparação", "Abordagem"...
  texto       String
  dica        String?
  responsavel String? // "lari" ou "claude"
  feita       Boolean  @default(false)
  posicao     Int      @default(0)

  createdAt DateTime @default(now())

  @@index([campanhaId])
}

model Criadora {
  id           String  @id @default(cuid())
  nome         String? // como chamar na DM ("Camile")
  nomeCompleto String? // vem do formulario
  instagram    String? @unique // handle sem @, minusculo
  tiktok       String?
  youtube      String? // handle, link ou "tem canal"
  linkOrigem   String? // o link colado na captura

  seguidoresInstagram Int?
  seguidoresTiktok    Int?
  seguidoresYoutube   Int?

  nicho       String?
  motivo      String? // por que achou interessante
  alerta      String? // ponto de atencao ("bio em ingles", "e mentora")
  observacoes String?
  gancho      String? // frase pessoal que entra na DM

  origem     OrigemCriadora @default(prospeccao)
  status     StatusCriadora @default(nova)
  statusEm   DateTime       @default(now()) // quando entrou no status atual
  campanhaId String?
  campanha   Campanha?      @relation(fields: [campanhaId], references: [id], onDelete: SetNull)
  lote       Int?
  kit        String? // "Case Início", "Premium", "Reserva"...

  email    String?
  whatsapp String? // so numeros, com DDD
  endereco String? // pro envio (vem do formulario)

  acordo          TipoAcordo?
  valorCombinado  Decimal?    @db.Decimal(10, 2) // cache, quando pago
  comissaoPct     Decimal?    @db.Decimal(5, 2) // afiliada
  pago            Boolean     @default(false)
  pagoEm          DateTime?
  autorizaAnuncio Boolean     @default(false) // pode usar o video como anuncio
  anuncioAte      DateTime?

  cupom             String?   @unique // codigo do Shopify, maiusculo
  cupomPedidos      Int?
  cupomVendas       Decimal?  @db.Decimal(12, 2)
  cupomAtualizadoEm DateTime?

  registros RegistroCriadora[]
  propostas PropostaUgc[]
  envios    EnvioParceria[]
  entregas  EntregaParceria[]
  respostas RespostaFormulario[]
  producao  ItemProducaoParceria[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([campanhaId])
}

// Historico de conversa com a criadora (o que ela respondeu, o que foi combinado).
model RegistroCriadora {
  id         String   @id @default(cuid())
  criadoraId String
  criadora   Criadora @relation(fields: [criadoraId], references: [id], onDelete: Cascade)
  data       DateTime @default(now())
  texto      String

  createdAt DateTime @default(now())

  @@index([criadoraId])
}

// Proposta recebida por DM, com a avaliacao (checklist manual ou Claude).
model PropostaUgc {
  id         String   @id @default(cuid())
  criadoraId String
  criadora   Criadora @relation(fields: [criadoraId], references: [id], onDelete: Cascade)
  recebidaEm DateTime @default(now())
  texto      String // a DM colada

  pedido      String? // "permuta", "pago" ou null (nao disse)
  valorPedido Decimal? @db.Decimal(10, 2)

  checklist     Json? // respostas da Lari: { estetica: "sim", ... }
  recomendacao  Recomendacao?
  justificativa String?
  perguntas     String? // o que ainda falta saber (uma por linha)
  analisadaPor  String? // "manual" ou "claude"
  analisadaEm   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([criadoraId])
}

model EnvioParceria {
  id         String    @id @default(cuid())
  criadoraId String
  criadora   Criadora  @relation(fields: [criadoraId], references: [id], onDelete: Cascade)
  data       DateTime  @default(now())
  rastreio   String?
  custoFrete Decimal?  @db.Decimal(10, 2)
  entregueEm DateTime?
  observacao String?

  itens ItemEnvioParceria[]

  createdAt DateTime @default(now())

  @@index([criadoraId])
}

// Produto mandado. O custo e copiado do Financeiro na hora de lancar (pra
// nao mudar depois se o material subir) e pode ser corrigido a mao.
model ItemEnvioParceria {
  id            String        @id @default(cuid())
  envioId       String
  envio         EnvioParceria @relation(fields: [envioId], references: [id], onDelete: Cascade)
  varianteId    String?
  variante      Variante?     @relation(fields: [varianteId], references: [id], onDelete: SetNull)
  descricao     String
  quantidade    Int           @default(1)
  custoUnitario Decimal?      @db.Decimal(10, 2)

  @@index([envioId])
}

// Post/video combinado com a criadora.
model EntregaParceria {
  id          String    @id @default(cuid())
  criadoraId  String
  criadora    Criadora  @relation(fields: [criadoraId], references: [id], onDelete: Cascade)
  formato     String // Reels, Stories, TikTok, YouTube, Post, Review...
  prazo       DateTime?
  publicadoEm DateTime?
  link        String?
  sinalizou   Boolean   @default(false) // "recebi de presente" / #publi
  observacao  String?

  createdAt DateTime @default(now())

  @@index([criadoraId])
}

// Checklist de producao do envio: o que a Lari precisa preparar pra cada
// criadora que fechou (cupom, case, blocos impressos, cartao a mao, caixa,
// despacho). Mesma ideia da Central de Producao: lista agrupada por etapa,
// um quadradinho por criadora. Os itens nascem de um modelo e podem ser
// ajustados a mao na ficha.
model ItemProducaoParceria {
  id         String    @id @default(cuid())
  criadoraId String
  criadora   Criadora  @relation(fields: [criadoraId], references: [id], onDelete: Cascade)
  etapa      String // cupom, kit, blocos, cartao, embalar, enviar ou outro (ver lib/parcerias/producao.ts)
  texto      String // o que fazer pra ela ("Cartão para Camile com o cupom CAMILE10")
  feito      Boolean   @default(false)
  feitoEm    DateTime?
  posicao    Int       @default(0)

  createdAt DateTime @default(now())

  @@index([criadoraId])
  @@index([etapa, feito])
}

// Resposta do Google Forms de permuta, recebida pelo Apps Script. Fica guardada
// inteira; quando o @ bate com uma criadora, os dados de contato vao pra ficha.
model RespostaFormulario {
  id         String    @id @default(cuid())
  criadoraId String?
  criadora   Criadora? @relation(fields: [criadoraId], references: [id], onDelete: SetNull)
  enviadaEm  DateTime  @default(now())
  instagram  String? // como ela digitou
  respostas  Json // [{ pergunta, resposta }]
  chave      String    @unique // evita duplicar quando o script reenvia tudo

  createdAt DateTime @default(now())
}

// Modelos de DM. Variaveis: {nome}, {gancho}, {cupom}.
model ModeloMensagem {
  id      String @id @default(cuid())
  titulo  String
  texto   String
  posicao Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Modulo Marketing: calendario de conteudo em lotes de 15 dias e a lista de
// tarefas da Lari. Os conteudos entram pelo script
// scripts/marketing-importar.mjs (um JSON por lote, em marketing/lotes/);
// a tela aprova, pede ajuste e marca o andamento. Prefixo Mkt pra nao
// colidir com nomes de outros modulos.

enum MktCanal {
  stories
  instagram
  tiktok
  youtube
  email
  blog
}

// realista: o essencial do ritmo que a Lari da conta sozinha.
// extra: o que completa ate o ritmo do plano estrategico.
enum MktNivel {
  realista
  extra
}

enum MktStatus {
  roteiro // escrito, esperando a aprovacao da Lari
  ajustar // a Lari pediu mudanca (ver notaLari)
  aprovado // pode gravar/fotografar
  gravado // material pronto, falta postar
  publicado
}

model MktLote {
  id            String   @id @default(cuid())
  numero        Int      @unique
  titulo        String
  foco          String? // tema/campanha do lote
  inicio        DateTime @db.Date
  fim           DateTime @db.Date
  pastaDriveUrl String? // pasta onde a Lari sobe fotos e videos do lote

  conteudos MktConteudo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MktConteudo {
  id     String  @id @default(cuid())
  codigo String  @unique // chave estavel do JSON: reimportar atualiza em vez de duplicar
  loteId String
  lote   MktLote @relation(fields: [loteId], references: [id], onDelete: Cascade)

  data     DateTime @db.Date
  horario  String? // "19h"
  canal    MktCanal
  formato  String // Reels, Carrossel, Sequencia de stories, Short, Video, E-mail...
  nivel    MktNivel
  pilar    String?
  campanha String?

  titulo      String
  objetivo    String?
  gancho      String?
  // [{ "cena": "...", "fala": "...", "tela": "...", "imagem": "..." }]
  roteiro     Json?
  legenda     String? @db.Text
  cta         String?
  hashtags    String?
  producao    String? @db.Text // o que gravar/fotografar, uma linha por item
  produtos    String? // produtos que aparecem, com link quando houver
  reaproveita String? // codigo do conteudo de origem (ex: TikTok do Reels)
  observacao  String? @db.Text

  status        MktStatus @default(roteiro)
  notaLari      String?   @db.Text
  linkPublicado String?
  statusEm      DateTime?

  tarefas MktTarefa[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([loteId, data])
}

// Tarefas avulsas que dependem da Lari (decidir, criar pasta, mandar algo).
// Aprovar, gravar e postar conteudo nao viram linha aqui: saem do status de
// cada MktConteudo na hora de montar a lista.
model MktTarefa {
  id         String       @id @default(cuid())
  codigo     String       @unique
  titulo     String
  detalhe    String?      @db.Text
  tipo       String // decidir, foto, video, aprovar, publicar, configurar, outro
  prazo      DateTime?    @db.Date
  link       String?
  linkRotulo String?
  conteudoId String?
  conteudo   MktConteudo? @relation(fields: [conteudoId], references: [id], onDelete: SetNull)
  feita      Boolean      @default(false)
  feitaEm    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Modulo Tarefas: organizador que junta o que tem pra fazer, aprovar ou
// conferir em todos os modulos. Aqui so moram as tarefas cadastradas a mao;
// as automaticas (aprovar roteiro, preparar envio de criadora, comprar
// material...) sao calculadas na hora a partir de cada modulo
// (src/lib/tarefas/fontes.ts), entao nunca ficam desatualizadas.

enum TarefaStatus {
  a_fazer
  em_andamento
  concluido
}

model Tarefa {
  id        String  @id @default(cuid())
  titulo    String
  descricao String? @db.Text

  categoria String // chave de CATEGORIAS em src/lib/tarefas/meta.ts
  tags      String[] // chaves de TAGS (urgente, prioridade, aguardando...)
  status    TarefaStatus @default(a_fazer)
  prazo     DateTime?    @db.Date

  // Link opcional pra mais detalhes: pagina do app (/financeiro/...) ou URL externa.
  link String?

  // Sub-itens [{ texto, feito }] -- alimentam a barra de progresso.
  checklist Json?

  // Concluida ha mais de 15 dias e excluida de vez (ver carregar.ts).
  concluidaEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([prazo])
}
